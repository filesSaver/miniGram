{
  "name": "telegram-content-download",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up --build -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "docker compose build",
    "test": "echo \"Error: no test specified\" && exit 1",

    "local:db": "docker compose -f docker-compose.local.yml --env-file .env.local up -d",
    "local:db:stop": "docker compose -f docker-compose.local.yml down",
    "local:install": "npm i --prefix services/db-service && npm i --prefix services/auth-service && npm i --prefix services/telegram-read-service && npm i --prefix services/telegram-download-service && npm i --prefix services/api-gateway && npm i --prefix services/ui-service",
    "local:start": "node scripts/local-start.js",
    "local:stop": "npm run local:db:stop"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehtasaurav/telegram-content-download.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mehtasaurav/telegram-content-download/issues"
  },
  "homepage": "https://github.com/mehtasaurav/telegram-content-download#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
